<UserControl x:Class="Scheduler.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Scheduler.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x25C0;" Command="{Binding PreviousMonthCommand}"
                            Width="34" Height="34" FontSize="14"
                            Background="Transparent" BorderBrush="#CCCCCC"
                            Cursor="Hand"/>
                    <Button Content="Today" Command="{Binding GoToTodayCommand}"
                            Margin="8,0" Height="34" Padding="16,0"
                            Background="White" BorderBrush="#CCCCCC"
                            Cursor="Hand"/>
                    <Button Content="&#x25B6;" Command="{Binding NextMonthCommand}"
                            Width="34" Height="34" FontSize="14"
                            Background="Transparent" BorderBrush="#CCCCCC"
                            Cursor="Hand"/>
                </StackPanel>
                <TextBlock Text="{Binding MonthTitle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#333333"/>
            </Grid>
        </Border>

        <!-- Main area: prev peek | current month | next peek -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>   <!-- prev peek, clipped -->
                <RowDefinition Height="*"/>     <!-- current month, full -->
                <RowDefinition Height="48"/>   <!-- next peek, clipped -->
            </Grid.RowDefinitions>

            <!-- Previous month preview: dimmed text only -->
            <TextBlock Grid.Row="0" Text="{Binding PrevMonthData.MonthTitle}"
                       FontSize="14" Foreground="#999999"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>

            <!-- Current month: full display -->
            <views:MonthView Grid.Row="1" x:Name="MainMonthView"
                             DataContext="{Binding}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>

            <!-- Next month preview: dimmed text only -->
            <TextBlock Grid.Row="2" Text="{Binding NextMonthData.MonthTitle}"
                       FontSize="14" Foreground="#999999"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</UserControl>
