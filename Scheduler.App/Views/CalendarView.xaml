<UserControl x:Class="Scheduler.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Scheduler.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x25C0;" Command="{Binding PreviousMonthCommand}"
                            Width="34" Height="34" FontSize="14"
                            Background="Transparent" BorderBrush="#CCCCCC"
                            Cursor="Hand"/>
                    <Button Content="Today" Command="{Binding GoToTodayCommand}"
                            Margin="8,0" Height="34" Padding="16,0"
                            Background="White" BorderBrush="#CCCCCC"
                            Cursor="Hand"/>
                    <Button Content="&#x25B6;" Command="{Binding NextMonthCommand}"
                            Width="34" Height="34" FontSize="14"
                            Background="Transparent" BorderBrush="#CCCCCC"
                            Cursor="Hand"/>
                </StackPanel>
                <TextBlock Text="{Binding MonthTitle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#333333"/>
            </Grid>
        </Border>

        <!-- Single month view -->
        <views:MonthView Grid.Row="1" DataContext="{Binding}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
