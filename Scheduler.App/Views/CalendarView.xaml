<UserControl x:Class="Scheduler.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Scheduler.App.Views">

    <UserControl.Resources>
        <Style x:Key="MonthHintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MonthHintButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Today" Command="{Binding GoToTodayCommand}"
                            Height="34" Padding="16,0"
                            Background="White" BorderBrush="#CCCCCC"
                            Cursor="Hand"/>
                </StackPanel>
                <TextBlock Text="{Binding MonthTitle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#333333"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Click="PreviousHintButton_Click"
                    Style="{StaticResource MonthHintButtonStyle}"
                    BorderBrush="#E9E9E9"
                    BorderThickness="0,0,0,1">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FAFAFA" Offset="0"/>
                        <GradientStop Color="#D8FAFAFA" Offset="0.42"/>
                        <GradientStop Color="#30FAFAFA" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="&#x25B2;"
                               FontSize="11"
                               Foreground="#A0A0A0"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding PrevMonthData.MonthTitle}"
                               Style="{StaticResource MonthHintTextStyle}"/>
                </StackPanel>
            </Button>

            <!-- Month viewport: a clipped camera looking at one moving paper. -->
            <Border x:Name="Viewport"
                    Grid.Row="1"
                    Background="Transparent"
                    ClipToBounds="True"
                    Cursor="SizeNS"
                    SizeChanged="Viewport_SizeChanged"
                    PreviewMouseLeftButtonDown="Viewport_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Viewport_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="Viewport_PreviewMouseLeftButtonUp"
                    LostMouseCapture="Viewport_LostMouseCapture">
                <Canvas x:Name="Paper"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="PaperTransform" Y="0"/>
                    </Canvas.RenderTransform>

                    <views:MonthView x:Name="PrevMonthView"
                                     DataContext="{Binding PrevMonthData}"/>
                    <views:MonthView x:Name="CurrentMonthView"
                                     DataContext="{Binding CurrentMonthData}"/>
                    <views:MonthView x:Name="NextMonthView"
                                     DataContext="{Binding NextMonthData}"/>
                </Canvas>
            </Border>

            <Button Grid.Row="2"
                    Click="NextHintButton_Click"
                    Style="{StaticResource MonthHintButtonStyle}"
                    BorderBrush="#E9E9E9"
                    BorderThickness="0,1,0,0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#30FAFAFA" Offset="0"/>
                        <GradientStop Color="#D8FAFAFA" Offset="0.58"/>
                        <GradientStop Color="#FAFAFA" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding NextMonthData.MonthTitle}"
                               Style="{StaticResource MonthHintTextStyle}"/>
                    <TextBlock Text="&#x25BC;"
                               FontSize="11"
                               Foreground="#A0A0A0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
